<?xml version="1.0" encoding="utf-8"?>
<!-- Remote mode (#51): SSH to a computer and drive the dsh installed there. -->
<resources>
    <string name="set_remote">远程主机</string>
    <string name="remote_intro">通过 SSH 连接你的电脑或服务器，使用那台机器上安装的 dsh（0.2.2 及以上）：对话、轨迹和审批照常在手机上进行，命令和文件操作都发生在电脑上。电脑需要开启 sshd，并能运行 dsh（Linux / macOS）。</string>
    <string name="remote_scope_note">远程会话里没有手机能力（读屏、通知、短信、文件附件等）和会话模式；模型由电脑上的 dsh 提供，图片会随消息发送过去。断网或切换网络后会自动重连并续上任务。</string>
