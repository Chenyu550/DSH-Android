    <string name="remote_trust_title">首次连接：确认主机指纹</string>
    <string name="remote_trust_body">%1$s 的主机密钥指纹是：</string>
    <string name="remote_trust_check">可以在电脑上运行 ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub 核对。指纹一致再信任；之后每次连接都会核对。</string>
    <string name="remote_trust">信任并连接</string>
    <string name="remote_changed_title">⚠ 主机指纹已变化</string>
    <string name="remote_changed_body">%1$s 的主机密钥和上次信任的不一样。\n\n之前：%2$s\n现在：%3$s\n\n可能有人在冒充这台电脑（中间人攻击），密码和对话内容会被截获。只有在你确认电脑重装了系统或重新生成了 SSH 主机密钥，并在电脑上核对过新指纹时，才信任新指纹。</string>
    <string name="remote_changed_check">我已在电脑上核对新指纹</string>
    <string name="remote_changed_trust">信任新指纹</string>
    <string name="remote_delete_title">删除远程主机？</string>
    <string name="remote_delete_body">会删除这台主机的连接信息和保存的密码 / 私钥，以及它在手机上的会话记录。电脑上 dsh 自己的会话不受影响。</string>

    <string name="remote_error_title">无法使用远程电脑</string>
    <string name="remote_open_settings">远程主机设置</string>
    <string name="remote_recovering">与电脑的连接断开了，正在重连并继续任务…</string>
    <string name="err_remote_lost">与电脑的连接断开了，本轮已中断。</string>
    <string name="remote_err_offline">手机没有网络连接。</string>
    <string name="remote_err_dns">无法解析主机地址：请检查域名是否正确，或改用 IP 地址。</string>
    <string name="remote_err_timeout">连接超时：电脑不在线、地址不对，或者网络之间不通（不在同一局域网时需要公网地址、端口转发或 Tailscale 等）。</string>
    <string name="remote_err_refused">连接被拒绝：电脑上的 sshd 没有运行，或端口不对。</string>
    <string name="remote_err_unreachable">网络不可达：手机和电脑之间没有路由。</string>
    <string name="remote_err_hostkey_unknown">还没有确认这台电脑的主机指纹：请到 设置 → 远程主机，打开这台主机点「测试连接」并核对指纹。</string>
    <string name="remote_err_hostkey_changed">⚠ 电脑的主机指纹变了（现在是 %1$s），已拒绝连接：可能有人在冒充这台电脑。确认是你重装或换了密钥后，到 设置 → 远程主机 重新核对并信任。</string>
    <string name="remote_err_auth">认证失败：用户名、密码不对，或电脑不接受这把私钥（检查 ~/.ssh/authorized_keys）。</string>
    <string name="remote_err_key_invalid">无法读取私钥（%1$s）：支持 OpenSSH 或 PEM 格式。</string>
    <string name="remote_err_key_passphrase">私钥密码不对，或私钥已加密但没有填写密码。</string>
    <string name="remote_err_workdir">电脑上进不去工作目录：%1$s</string>
    <string name="remote_err_no_dsh">电脑上找不到 dsh（%1$s）。请先在电脑上安装 dsh（npm i -g @deepseek-ai/dsh），或在主机设置里填写 dsh 命令的完整路径。</string>
    <string name="remote_err_dsh_exited">电脑上的 dsh 启动失败：%1$s</string>
    <string name="remote_err_initialize">电脑上的 dsh 拒绝了模型设置：%1$s。请检查主机设置里的模型，或电脑上 dsh 的模型服务配置。</string>
    <string name="remote_err_host_missing">这台远程主机已被删除。</string>
    <string name="remote_fork_unsupported">电脑上的 dsh 不支持分叉</string>
    <string name="remote_err_other">远程连接出错：%1$s</string>
</resources>
